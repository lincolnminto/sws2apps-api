# GENERATED by scripts/setup-env.sh — do not edit by hand. No secrets here.
# Loaded when NODE_ENV=development (npm run dev). Routes firebase-admin to the
# local emulators, so the base .env service-account credentials are ignored.
FIREBASE_APP_NAME=organized-local
FIREBASE_AUTH_EMULATOR_HOST=127.0.0.1:9099
FIREBASE_STORAGE_EMULATOR_HOST=127.0.0.1:9199
FIRESTORE_EMULATOR_HOST=127.0.0.1:8080
APP_COUNTRY_API=https://collect-api.sws2apps.com/api/countries?
APP_CONGREGATION_API=https://collect-api.sws2apps.com/api/congregations?
MAIL_ENABLED=false
